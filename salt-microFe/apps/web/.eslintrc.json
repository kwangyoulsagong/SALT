{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": [
    "@repo/zone",
    "@repo/fsd"
  ],
  "rules": {
    "@repo/zone/no-cross-zone-link": [
      "error",
      {
        "zonePaths": [
          "/tax",
          "/tax-static"
        ]
      }
    ],
    "@repo/fsd/layers": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "axios",
            "message": "`@/shared/api` 의 `apiFetch` 를 쓴다. axios 는 GET 하나에 라이브러리 전체를 번들에 넣어 회귀를 세 번 냈다 (FE-REQ-035)."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "next-env.d.ts",
    ".next/"
  ]
}
