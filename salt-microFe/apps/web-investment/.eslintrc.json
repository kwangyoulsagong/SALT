{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": [
    "@repo/zone",
    "@repo/fsd"
  ],
  "rules": {
    "@repo/zone/no-cross-zone-link": "error",
    "@repo/fsd/layers": "error",
    "@repo/fsd/no-render-read": "error"
  },
  "ignorePatterns": [
    "next-env.d.ts",
    ".next/",
    "next.config.js"
  ]
}
