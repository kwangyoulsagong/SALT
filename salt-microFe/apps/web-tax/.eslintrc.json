{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": [
    "@repo/zone"
  ],
  "rules": {
    "@repo/zone/no-cross-zone-link": [
      "error",
      {
        "zonePaths": [
          "/",
          "/home",
          "/investments",
          "/goals"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "next-env.d.ts",
    ".next/"
  ]
}
