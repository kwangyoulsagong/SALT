{
  "name": "salt-microFe",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev": "turbo dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo lint",
    "prepare": "husky install",
    "test:layer-check": "node .claude/hooks/__tests__/layer-check.test.mjs"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.14.0",
    "lightweight-charts": "^5.0.9",
    "next": "^15.5.25",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.5.25",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.3",
    "turbo": "latest",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "apps/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
