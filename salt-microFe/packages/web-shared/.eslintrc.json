{
  "root": true,
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "plugins": [
    "@repo/zone",
    "@repo/fsd"
  ],
  "settings": {
    "next": {
      "rootDir": "../../apps/web"
    }
  },
  "rules": {
    "@repo/zone/no-cross-zone-link": "error",
    "@repo/fsd/layers": "error",
    "@next/next/no-html-link-for-pages": "off",
    "@repo/fsd/no-render-read": "error",
    "@repo/fsd/no-client-enum-export": "error"
  }
}
