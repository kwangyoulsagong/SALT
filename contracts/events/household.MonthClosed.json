{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salt.local/contracts/events/household.MonthClosed.json",
  "title": "household.MonthClosed",
  "description": "사용자가 한 달을 닫았다(SRV-REQ-046 FR-9, DB-REQ-038 FR-7 month_close). 처음 닫을 때 한 번 — 답을 고쳐도 다시 나가지 않는다. 리뷰 답 글은 싣지 않는다(가계부 S1b 판단 7). budgetTotal = 닫을 때 붙잡은 봉투 합(예산이 없던 달이면 null). 구독 예정: savings 속도(저축 S2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "closeId",
    "userId",
    "month",
    "total",
    "exact",
    "approx",
    "count",
    "budgetTotal",
    "closedAt"
  ],
  "properties": {
    "closeId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "total": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "exact": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "approx": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "budgetTotal": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d+(\\.\\d+)?$"
    },
    "closedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
