// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User ====================
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  nickname        String
  passwordHash    String    @map("password_hash")
  profileImageUrl String?   @map("profile_image_url")
  totalPoints     Int       @default(0) @map("total_points")
  userLevel       Int       @default(1) @map("user_level")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastLoginAt     DateTime? @map("last_login_at")

  goals                   Goal[]
  savingTransactions      SavingTransaction[]
  watchlist               InvestmentWatchlist[]
  analysisSessions        AIAnalysisSession[]
  aiAnalyses              AIAnalysis[]
  missionProgress         UserMissionProgress[]
  achievements            UserAchievement[]
  pointTransactions       PointTransaction[]
  portfolioTransactions   PortfolioTransaction[]
  portfolioHoldings       PortfolioHolding[]
  newsBookmarks           NewsBookmark[]
  sentimentAlerts         SentimentAlert[]
  smartMoneyAlerts        SmartMoneyAlert[]
  investmentProfile       UserInvestmentProfile?
  insights                InvestmentInsight[]
  executionLogs           ExecutionLog[]
  investmentNotifications InvestmentNotification[]
  inviteCode              InviteCode?

  @@index([email])
  @@map("users")
}

// ==================== Invite (F000 · 비공개 초대제) ====================

/**
 * 초대 코드. 본인 + 최대 10명이라는 제품 정의(글로벌 플랜 1-1절)를 여기서 지킨다.
 * `usedByUserId` 가 유니크인 것이 **한 사람이 코드 두 장을 쓰지 못하게** 하고,
 * `usedByUserId IS NULL` 조건부 UPDATE 가 **같은 코드의 동시 사용**을 하나로 만든다
 * (`SRV-REQ-008` FR-4).
 */
model InviteCode {
  id           String    @id @default(uuid())
  code         String    @unique
  expiresAt    DateTime  @map("expires_at")
  usedByUserId String?   @unique @map("used_by_user_id")
  usedAt       DateTime? @map("used_at")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  usedBy User? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("invite_codes")
}

/**
 * 실패한 코드 시도 (`SRV-REQ-008` FR-7).
 * **잠금 정책을 만들지 않는다.** 사용자가 10명 이하라 잠금이 본인을 막을 위험이 더 크다.
 * 여기 쌓이는 것은 무차별 대입을 나중에 알아볼 근거이고, 코드 원문을 남기지 않기 위해
 * 앞 4자만 저장한다.
 */
model InviteCodeAttempt {
  id         String   @id @default(uuid())
  codePrefix String   @map("code_prefix")
  reasonCode String   @map("reason_code")
  clientKey  String?  @map("client_key")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("invite_code_attempts")
}

// ==================== Goal ====================
model Goal {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  title         String
  category      GoalCategory
  targetAmount  Decimal
  currentAmount Decimal      @default(0) @map("current_amount")
  startDate     DateTime     @map("start_date")
  targetDate    DateTime     @map("target_date")
  status        GoalStatus   @default(active)
  themeColor    String       @default("#4A90E2") @map("theme_color")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  completedAt   DateTime?    @map("completed_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions SavingTransaction[]

  @@index([userId, status])
  @@map("goals")
}

enum GoalCategory {
  travel
  first_car
  startup
  wedding
  creative
  other
}

enum GoalStatus {
  active
  completed
  paused
}

// ==================== Saving Transaction ====================
model SavingTransaction {
  id              String   @id @default(uuid())
  goalId          String   @map("goal_id")
  userId          String   @map("user_id")
  amount          Decimal
  note            String?
  transactionDate DateTime @map("transaction_date")
  createdAt       DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, transactionDate])
  @@index([userId, transactionDate])
  @@map("saving_transactions")
}

// ==================== Investment Watchlist ====================
model InvestmentWatchlist {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  assetType      AssetType @map("asset_type")
  symbol         String
  name           String
  currentPrice   Decimal?  @map("current_price")
  priceChange24h Decimal?  @map("price_change_24h")
  lastUpdated    DateTime? @map("last_updated")
  addedAt        DateTime  @default(now()) @map("added_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetType, symbol])
  @@index([userId, assetType])
  @@map("investment_watchlist")
}

enum AssetType {
  crypto
  stock
}

// ==================== AI Analysis Session ====================
model AIAnalysisSession {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  assetType    AssetType      @map("asset_type")
  symbol       String
  status       AnalysisStatus @default(pending)
  progress     Int            @default(0)
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")
  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses AIAnalysis[]

  @@index([userId, createdAt])
  @@map("ai_analysis_sessions")
}

enum AnalysisStatus {
  pending
  processing
  completed
  failed
}

// ==================== AI Analysis ====================
model AIAnalysis {
  id              String         @id @default(uuid())
  sessionId       String         @map("session_id")
  userId          String         @map("user_id")
  assetType       AssetType      @map("asset_type")
  symbol          String
  prediction      PredictionType
  confidenceScore Decimal?       @map("confidence_score")
  analysisText    String         @map("analysis_text")
  keyFactors      Json?          @map("key_factors")
  priceAtAnalysis Decimal        @map("price_at_analysis")
  analyzedAt      DateTime       @default(now()) @map("analyzed_at")

  session AIAnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, analyzedAt])
  @@map("ai_analyses")
}

enum PredictionType {
  bullish
  bearish
  neutral
}

// ==================== Daily Mission ====================
model DailyMission {
  id           String      @id @default(uuid())
  title        String
  description  String
  missionType  MissionType @map("mission_type")
  pointsReward Int         @map("points_reward")
  difficulty   Difficulty  @default(easy)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")

  userProgress UserMissionProgress[]

  @@map("daily_missions")
}

enum MissionType {
  saving
  investment
  learning
  social
}

enum Difficulty {
  easy
  medium
  hard
}

// ==================== User Mission Progress ====================
model UserMissionProgress {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  missionId   String                @map("mission_id")
  status      MissionProgressStatus @default(pending)
  startedAt   DateTime              @map("started_at")
  completedAt DateTime?             @map("completed_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission DailyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, startedAt])
  @@index([userId, startedAt])
  @@map("user_mission_progress")
}

enum MissionProgressStatus {
  pending
  completed
  failed
}

// ==================== User Achievement ====================
model UserAchievement {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  achievementType String   @map("achievement_type")
  title           String
  description     String?
  iconUrl         String?  @map("icon_url")
  earnedAt        DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, earnedAt])
  @@map("user_achievements")
}

// ==================== Point Transaction ====================
model PointTransaction {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  amount          Int
  transactionType TransactionType @map("transaction_type")
  source          String
  description     String?
  createdAt       DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("point_transactions")
}

enum TransactionType {
  earn
  spend
}

// ==================== Portfolio Tracking ====================
model PortfolioTransaction {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  symbol          String
  transactionType String    @map("transaction_type") // 'buy' or 'sell'
  quantity        Float // 수량
  price           Float // 거래 단가
  totalAmount     Float     @map("total_amount") // 총 금액 (수량 * 단가)
  fee             Float     @default(0) // 수수료
  note            String? // 메모
  transactionDate DateTime  @map("transaction_date") // 거래 날짜
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  assetType       AssetType @map("asset_type")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assetType, symbol])
  @@index([userId, transactionDate])
  @@index([transactionType])
  @@map("portfolio_transactions")
}

model PortfolioHolding {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  symbol    String
  assetType AssetType @map("asset_type")

  totalQuantity   Float @map("total_quantity")
  averageBuyPrice Float @map("average_buy_price")
  totalInvested   Float @map("total_invested")

  currentPrice Float @default(0) @map("current_price")
  currentValue Float @default(0) @map("current_value")

  unrealizedProfit     Float @default(0) @map("unrealized_profit")
  unrealizedProfitRate Float @default(0) @map("unrealized_profit_rate")

  realizedProfit Float @default(0) @map("realized_profit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, assetType])
  @@index([userId])
  @@map("portfolio_holdings")
}

// ==================== News ====================
model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  summary     String?  @db.Text
  url         String   @unique
  imageUrl    String?  @map("image_url")
  source      String // 'coingecko', 'cryptopanic', 'coindesk', etc
  author      String?
  symbols     String[] // ['BTC', 'ETH', 'XRP']
  sentiment   String? // 'positive', 'neutral', 'negative'
  viewCount   Int      @default(0) @map("view_count")
  publishedAt DateTime @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookmarks NewsBookmark[]

  @@index([publishedAt])
  @@index([source])
  @@index([symbols])
  @@map("news_articles")
}

model NewsBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  newsId    String   @map("news_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  news NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
  @@index([userId])
  @@map("news_bookmarks")
}

model MarketAsset {
  symbol      String    @id
  market      String
  koreanName  String    @map("korean_name")
  englishName String    @map("english_name")
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  listedAt    DateTime? @map("listed_at")
  delistedAt  DateTime? @map("delisted_at")

  currentPrice   Decimal?  @map("current_price")
  change24h      Decimal?  @map("change_24h")
  high24h        Decimal?  @map("high_24h")
  low24h         Decimal?  @map("low_24h")
  volume24h      Decimal?  @map("volume_24h")
  tradeValue24h  Decimal?  @map("trade_value_24h")
  priceUpdatedAt DateTime? @map("price_updated_at")
  assetType      AssetType @default(crypto) @map("asset_type")

  @@index([isActive])
  @@index([tradeValue24h]) // 🔥 TOP ranking 조회용
  @@index([change24h]) // 변동률 정렬 시 빠르게
  @@index([currentPrice]) // 가격 기준 정렬
  @@index([priceUpdatedAt]) // 오래된 가격만 background update
  @@map("market_assets")
}

// ==================== Market Intelligence ====================

// 시장 심리 데이터
model MarketSentiment {
  id             String   @id @default(uuid())
  symbol         String // BTC, ETH, etc
  sentimentScore Int      @map("sentiment_score") // 0-100
  fearGreedIndex Int?     @map("fear_greed_index") // 0-100
  volatility     Float // 변동성 %
  volume24h      Float    @map("volume_24h") // 24시간 거래량
  priceChange24h Float    @map("price_change_24h") // 24시간 가격변동 %
  socialMentions Int      @default(0) @map("social_mentions")
  searchTrend    Int      @default(0) @map("search_trend")
  sentimentLabel String   @map("sentiment_label") // extreme_fear, fear, neutral, greed, extreme_greed
  calculatedAt   DateTime @default(now()) @map("calculated_at")

  @@index([symbol, calculatedAt])
  @@index([calculatedAt])
  @@map("market_sentiments")
}

// 고래 거래 추적
model WhaleTransaction {
  id              String   @id @default(uuid())
  symbol          String
  transactionType String   @map("transaction_type") // buy, sell
  amount          Float // 코인 수량
  amountKRW       Float    @map("amount_krw") // 원화 환산
  exchange        String? // upbit, binance, etc
  detectedAt      DateTime @default(now()) @map("detected_at")

  @@index([symbol, detectedAt])
  @@map("whale_transactions")
}

// 심리 알림 설정
model SentimentAlert {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  symbol        String
  triggerScore  Int       @map("trigger_score") // 트리거 점수
  triggerType   String    @map("trigger_type") // below, above
  isActive      Boolean   @default(true) @map("is_active")
  lastTriggered DateTime? @map("last_triggered")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol, triggerType])
  @@index([userId])
  @@map("sentiment_alerts")
}

// 스마트 머니 알림 설정
model SmartMoneyAlert {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  symbol        String
  minAmount     Float     @map("min_amount") // 최소 거래 금액
  isActive      Boolean   @default(true) @map("is_active")
  lastTriggered DateTime? @map("last_triggered")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@map("smart_money_alerts")
}

// 투자 playbook notification
model InvestmentNotification {
  id String @id @default(cuid())

  userId String
  symbol String?

  source String?

  type    String
  title   String
  message String

  severity Int @default(50)

  isRead Boolean @default(false)

  payload Json?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([symbol])
  @@index([createdAt])
}

// 가격 히스토리
model PriceHistory {
  id        String    @id @default(uuid())
  symbol    String
  assetType AssetType @map("asset_type")

  timeframe String
  open      Decimal
  high      Decimal
  low       Decimal
  close     Decimal
  volume    Decimal?
  timestamp DateTime

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("price_history")
}

// 투자 성향
model UserInvestmentProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  riskTolerance        String @default("medium")
  maxSingleAssetWeight Float  @default(0.6)
  rebalanceBand        Float  @default(0.1)
  panicSellWindowHours Int    @default(24)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_investment_profiles")
}

// 투자 분석 결과 저장
enum InsightType {
  ai_coach
  smart_buy_zone
  behavior_analysis
  risk_alert
  // 아래 3개는 코드가 이미 쓰고 있었는데 enum 에 없었다.
  // Prisma 가 거부하므로 `whale-signal`·`portfolio-rebalance` 워커가 런타임에도 실패해 왔다.
  rebalance
  whale_buy_signal
  whale_sell_signal
}

model InvestmentInsight {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  symbol    String?
  assetType AssetType? @map("asset_type")

  type    InsightType
  title   String
  summary String

  severity   Int    @default(0)
  confidence Float?
  payload    Json?

  dedupeKey String @default("default") @map("dedupe_key")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dedupeKey])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("investment_insights")
}

// 종목 판단 스냅샷 (F004 · 감사 문서 D11 · B39)
//
// 종목 판단(`GET /api/ai-coach?symbol`)은 요청 때 계산하고 버려서 성적표 표본이 영원히 0이었다.
// 판단을 남겨 두고 관찰 기간(단타 24시간 · 장기 30일)이 지나면 결과를 매긴다.
//
// `InvestmentInsight` 에 `kind` 로 섞지 않은 이유(`DB-REQ-017` FR-50 과 다르다):
// 그 테이블은 피드 · 대시보드 · 점수 계산이 **타입 필터 없이** 읽는다. 스냅샷이 섞이면 거기로 쏟아진다.
// 판단은 사용자와 무관하므로(보유 여부가 점수에 들어가지 않는다) 사용자 열도 없다 — 종목 · 모드당 한 벌.
//
// 행 하나 = 표본 하나다. 같은 종목 · 모드는 관찰 기간 안에 한 번만 쓴다(B39 표본 독립성).
model SymbolJudgmentSnapshot {
  id         String   @id @default(uuid())
  symbol     String
  mode       String // "scalp" | "long_term"
  action     String // review_short_opportunity | review_accumulation | wait | avoid
  signalType String   @map("signal_type") // "<mode>.<action>" — 성적표 그룹 키
  score      Int
  reasons    Json // 판단 당시 근거 문장 — 표시용
  entryPrice Decimal  @map("entry_price")
  judgedAt   DateTime @map("judged_at")

  // 사후 판정. 관찰 기간이 지나고 종가가 있으면 채운다
  exitPrice   Decimal?  @map("exit_price")
  returnRate  Decimal?  @map("return_rate") @db.Decimal(12, 6)
  outcome     String? // "hit" | "miss"
  evaluatedAt DateTime? @map("evaluated_at")

  createdAt DateTime @default(now()) @map("created_at")

  // 유니크가 "종목 · 모드별 마지막 판단" 조회도 덮는다 — 같은 접두사 인덱스를 따로 두지 않는다
  @@unique([symbol, mode, judgedAt])
  @@index([signalType, outcome, judgedAt(sort: Desc)])
  @@index([evaluatedAt, judgedAt])
  @@map("symbol_judgment_snapshots")
}

// 게이지 아래 적중률 한 줄 (F004 · B9 · DB-REQ-017 FR-55).
// 게이지가 어떤 구간에 있던 과거 날들의 **30일 뒤 수익률 분포** — 일 1회 워커가 다시 쓴다.
// 과거 분포다. 예상 수익 · 목표가 컬럼을 두지 않는다(FR-58). 수익률은 비율(0.12 = 12%)
model GaugeTrackRecord {
  id           String   @id @default(uuid())
  symbol       String
  gauge        String // "sentiment" | "smart_money"
  bucket       String // "0_20" | "20_40" | "40_60" | "60_80" | "80_100" — 경계는 데이터다(FR-57)
  horizonDays  Int      @default(30) @map("horizon_days")
  sampleCount  Int      @map("sample_count")
  p25Return    Decimal? @map("p25_return") @db.Decimal(9, 4)
  medianReturn Decimal? @map("median_return") @db.Decimal(9, 4)
  p75Return    Decimal? @map("p75_return") @db.Decimal(9, 4)
  positiveRate Decimal? @map("positive_rate") @db.Decimal(5, 4)
  windowFrom   DateTime @map("window_from")
  windowTo     DateTime @map("window_to")
  computedAt   DateTime @map("computed_at")

  @@unique([symbol, gauge, bucket, horizonDays])
  @@map("gauge_track_records")
}

// 투자 실행 기록
model ExecutionLog {
  id     String @id @default(uuid())
  userId String @map("user_id")

  symbol String?

  action   String
  quantity Float?
  price    Float?

  note String?

  executedAt DateTime @default(now()) @map("executed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, executedAt])
  @@map("execution_logs")
}

enum Timeframe {
  m1
  m5
  m15
  h1
  h4
  d1
}

model TechnicalIndicator {
  id String @id @default(uuid())

  symbol    String
  assetType AssetType @map("asset_type")

  timeframe Timeframe
  timestamp DateTime

  rsi14 Float? @map("rsi_14")
  ma20  Float? @map("ma_20")
  ma50  Float? @map("ma_50")

  macd       Float?
  macdSignal Float? @map("macd_signal")
  macdHist   Float? @map("macd_hist")

  volumeAvg20 Float? @map("volume_avg_20")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([symbol, timeframe, timestamp])
  @@index([symbol, timeframe, timestamp])
  @@map("technical_indicators")
}
