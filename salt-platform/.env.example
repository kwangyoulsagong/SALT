# 복사해서 .env 로(커밋 금지 — .gitignore). JWT_SECRET 은 Express(salt-server/.env)와 같은 값 — 옛 HS 토큰 이중 기간(S3b, AUTH_LEGACY_HS_UNTIL 까지)만.
POSTGRES_USER=salt_admin
POSTGRES_PASSWORD=
PING_DB_PASSWORD=
SAVINGS_DB_PASSWORD=
HOUSEHOLD_DB_PASSWORD=
CONTENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
COACH_DB_PASSWORD=
RABBITMQ_USERNAME=salt
RABBITMQ_PASSWORD=
JWT_SECRET=

# identity 토큰 발급(서버 S3b, SRV-REQ-048 FR-8). 서명 개인키 = RSA 2048 PKCS#8 PEM 한 줄(\n 글자로 이음):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'BEGIN{ORS="\\n"}1'
IDENTITY_SIGNING_KEY=
# 옛 HS 갱신 토큰(Express JWT_REFRESH_SECRET 과 같은 값) · 옛 HS 를 받는 마지막 시각(ISO)
JWT_REFRESH_SECRET=
AUTH_LEGACY_HS_UNTIL=
