# postgresql://user:pass@localhost:5432/salt_db  (salt-server 와 같은 DB. ?schema= 는 떼도 되고 붙어 있어도 된다)
FORECAST_DATABASE_URL=
# 코인 외 추가 대상 (쉼표). 기본 대상은 업비트 원화 마켓 전체
FORECAST_EXTRA_SYMBOLS=
# 네이버 데이터랩 검색어트렌드(FC-REQ-017) — 네이버 클라우드 NAVER API HUB 앱의 Client ID/Secret(검색어 트렌드 켬). 비우면 수집을 건너뛴다
FORECAST_NAVER_CLIENT_ID=
FORECAST_NAVER_CLIENT_SECRET=

# 국내 주요 사건 반응 종목(FC-REQ-021 FR-6) — 비우면 보유 · 관심 국내 종목 + 거래대금 상위 FORECAST_KR_EVENT_TOP(30) + 시장 대용 KR-EW
FORECAST_KR_EVENT_SYMBOLS=
